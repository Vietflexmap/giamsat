# Open STAC catalog used by the Shapefile clip route.
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
STAC_SIGN_ASSETS=true
STAC_MAX_ITEMS=100

# Runtime storage for masked COG/PNG/aoi GeoJSON artifacts.
OUTPUT_ROOT=./outputs
MAX_BOUNDARY_UPLOAD_BYTES=209715200
JOB_TTL_SECONDS=3600
JOB_WORKERS=2

# Optional Earth Engine project used only by the legacy monitoring route.
EE_PROJECT=your-gcp-project

# FeatureCollection asset containing the same 34/3,321 administrative units.
# The property must contain normalized string codes matching sapnhap/admin.json.
EE_ADMIN_ASSET=projects/your-gcp-project/assets/vn_admin_2025
EE_ADMIN_CODE_FIELD=code

# Prefer Application Default Credentials / Workload Identity in deployment.
# Do not commit a service-account JSON file or private key.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google/application_default_credentials.json

# Comma-separated browser origins. Use the exact GitHub Pages origin in production.
CORS_ORIGINS=http://localhost:8080,https://vietflexmap.github.io

# Small in-memory job store for the reference service. Use Redis/Postgres in production.
MAX_RESULT_FEATURES=3000
